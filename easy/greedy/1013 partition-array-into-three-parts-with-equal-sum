class Solution {
public:
    
    bool canThreePartsEqualSum(vector<int>& arr) {
        int n=arr.size();
        int sum=0,curr=0;
        for(int &x:arr) sum+=x;
        if(sum%3!=0) return false;
        sum=sum/3;
        int k=3;
        for(int &x:arr){
            curr+=x;
            if(curr==sum){
                k--;
                curr=0;
            }
            if(k==0) return true;
        }
        return false;
    }
};

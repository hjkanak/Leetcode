class Solution {
public:
    bool canPlaceFlowers(vector<int>& flowerbed, int n) {
        int sz=flowerbed.size();
        int curr=0;
        for(int i=0;i<sz;i++){
            if(flowerbed[i]==0){
                if((i==0 or flowerbed[i-1]!=1) and (i==sz-1 or  flowerbed[i+1]!=1)) curr++;
            }
            else {
                n-=((curr+1)/2);
                curr=0;
                if(n<=0) return true;
            }
        }   
        n-=((curr+1)/2);
        if(n<=0) return true;
        return false;
    }
};

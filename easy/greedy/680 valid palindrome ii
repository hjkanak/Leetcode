class Solution {
public:
    bool helper(string &s, int i,int j,bool first){
        while(i<j){
            if(s[i]==s[j]) {
                i++;
                j--;
            }
            else if(first) return false;
            else{
                return helper(s,i+1,j,true) or helper(s,i,j-1,true);
            }  
        }
        return true;
    }
    bool validPalindrome(string s) {
        int n=s.length();
        return helper(s,0,n-1,false);
    }
};

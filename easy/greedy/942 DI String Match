class Solution {
public:
    vector<int> diStringMatch(string s) {
        int n=s.length();
        vector<int> res;
        int low=0,high=n;
        for(char &ch:s){
            if(ch=='I') res.push_back(low++);
            else res.push_back(high--);
        }
        res.push_back(low);
        return res;
    }
};

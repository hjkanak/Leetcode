class Solution {
public:
    int longestPalindrome(string s) {
        int n=s.length();
        vector<int> cnt(256,0);
        int cn=0,odd=0;
        for(int i=0;i<n;i++){
            cnt[s[i]]++;
            if(cnt[s[i]]&1==1){
                odd++;
            }else {
                cn+=2;
                odd--;
            }
        }
        if(odd) cn++;  // return n-odd+1;
        return cn;
        
    }
};

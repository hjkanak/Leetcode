class Solution {
public:
    int largestSumAfterKNegations(vector<int>& nums, int k) {
        sort(nums.begin(),nums.end());
        int sum=0,n=nums.size();
        for(int i=0;i<n;i++){
            if(k==0) {sum+=nums[i]; continue;}
            if(nums[i]<0){
                sum-=nums[i]; k--;
            }else if(nums[i]>0){
                sum+=nums[i];
                if(k&1==1){
                    if(i!=0 and ((-nums[i-1])<nums[i])){
                        sum+=(2*nums[i-1]);
                    }else sum-=(2*nums[i]);
                }
                k=0;
            }
        }
        if(k>0) sum+=(2*nums[n-1]);
        return sum;
    }
};

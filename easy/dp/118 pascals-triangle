class Solution {
public:
    vector<vector<int>> generate(int n) {
        vector<vector<int>> result(n);
        result[0].push_back(1);
        for(int i=1;i<n;i++){
            result[i].push_back(1);
            for(int j=1;j<i;j++){
                int x=result[i-1][j-1]+result[i-1][j];
                result[i].push_back(x);
            }
            result[i].push_back(1);
        }
        return result;
    }
};
